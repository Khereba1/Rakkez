<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/w_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/w_accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/w_on_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_check1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/w_text1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_check2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/w_text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_check3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/w_text3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row4"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_check4"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_w_check_off" />

        <TextView
            android:id="@+id/w_text4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/w_sub"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:textColor="@color/w_sub"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
